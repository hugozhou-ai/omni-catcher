{
  "schemaVersion": "tutti.app.manifest.v1",
  "appId": "omni-catcher",
  "version": "0.2.44",
  "name": "Omni Catcher",
  "description": "Capture anything, let an agent classify it, confirm, and save as local Markdown notes, bookmarks, and todos.",
  "icon": {
    "type": "asset",
    "src": "icon.png"
  },
  "runtime": {
    "bootstrap": "bootstrap.sh",
    "healthcheckPath": "/healthz"
  },
  "cli": {
    "manifest": "tutti.cli.json"
  },
  "references": {
    "listEndpoint": "/tutti/references/list",
    "searchEndpoint": "/tutti/references/search"
  },
  "window": {
    "minimizeBehavior": "keep-mounted",
    "minWidth": 760,
    "minHeight": 520
  },
  "author": {
    "name": "Omni Catcher"
  },
  "tags": [
    "notes",
    "capture",
    "workspace"
  ],
  "localizationInfo": {
    "defaultLocale": "en",
    "additionalLocales": [
      {
        "locale": "zh-CN",
        "file": "locales/zh-CN/manifest.json"
      }
    ]
  }
}
