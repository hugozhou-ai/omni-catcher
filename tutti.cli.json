{
  "schemaVersion": "tutti.app.cli.v1",
  "scope": "omni-catcher",
  "description": "Capture content and manage classified notes, bookmarks, and todos.",
  "documentation": {
    "file": "COMMANDS.md"
  },
  "commands": [
    {
      "path": ["capture"],
      "summary": "Capture content",
      "description": "Capture raw text or a URL. Classification runs asynchronously; poll with get.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Raw text to capture."
          },
          "url": {
            "type": "string",
            "description": "A URL to capture when content is omitted."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/capture",
        "timeoutMs": 30000
      }
    },
    {
      "path": ["list"],
      "summary": "List saved items",
      "description": "List confirmed notes, bookmarks, and todos.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Filter by type: note, bookmark, or todo."
          }
        }
      },
      "output": {
        "defaultMode": "table",
        "json": true,
        "table": {
          "columns": [
            { "key": "id", "label": "ID" },
            { "key": "type", "label": "Type" },
            { "key": "title", "label": "Title" },
            { "key": "tags", "label": "Tags" },
            { "key": "created", "label": "Created" }
          ]
        }
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/list",
        "timeoutMs": 30000
      }
    },
    {
      "path": ["get"],
      "summary": "Get one item or capture",
      "description": "Get a confirmed item or a pending capture by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item or capture id."
          }
        },
        "required": ["id"]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/get",
        "timeoutMs": 30000
      }
    },
    {
      "path": ["pending"],
      "summary": "List pending captures",
      "description": "List captures awaiting confirmation.",
      "output": {
        "defaultMode": "table",
        "json": true,
        "table": {
          "columns": [
            { "key": "id", "label": "ID" },
            { "key": "status", "label": "Status" },
            { "key": "intent", "label": "Intent" },
            { "key": "title", "label": "Title" },
            { "key": "created", "label": "Created" }
          ]
        }
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/pending",
        "timeoutMs": 30000
      }
    },
    {
      "path": ["confirm"],
      "summary": "Confirm a capture",
      "description": "Confirm a classified capture and write it to disk.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Capture id to confirm."
          },
          "intent": {
            "type": "string",
            "description": "Override intent: note, bookmark, or todo."
          }
        },
        "required": ["id"]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/confirm",
        "timeoutMs": 30000
      }
    },
    {
      "path": ["search"],
      "summary": "Search saved items",
      "description": "Full-text search across saved items.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query."
          }
        },
        "required": ["query"]
      },
      "output": {
        "defaultMode": "table",
        "json": true,
        "table": {
          "columns": [
            { "key": "id", "label": "ID" },
            { "key": "type", "label": "Type" },
            { "key": "title", "label": "Title" },
            { "key": "path", "label": "Path" }
          ]
        }
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/search",
        "timeoutMs": 30000
      }
    }
  ]
}
